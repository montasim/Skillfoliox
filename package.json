{
  "name": "skillfolio",
  "private": true,
  "description": "A curated portfolio of reusable SKILL.md capabilities for Claude Code, OpenAI Codex, Cursor, and other AI coding agents.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "skill-md",
    "skill-library",
    "claude-code",
    "openai-codex",
    "cursor",
    "developer-tools",
    "tanstack-start",
    "react",
    "typescript",
    "tailwindcss",
    "shadcn-ui"
  ],
  "homepage": "https://skillfoliox.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montasim/Skillfoliox.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm generate:seo && vite build",
    "generate:seo": "node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "jsdom": "^28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
